# Application
APP_NAME=Subscription Management System API
APP_ENV=development
API_PREFIX=/api

# MySQL
# The database and app user are created separately (see backend/README.md).
DATABASE_URL=mysql+pymysql://odoo_prelims:CHANGE_ME@127.0.0.1:3306/odoo_prelims?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://odoo_prelims:CHANGE_ME@127.0.0.1:3306/odoo_prelims_test?charset=utf8mb4

# JWT / tokens
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-at-least-64-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# SMTP (leave SMTP_HOST blank in development to use the local dev outbox)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_TLS=true
MAIL_DEV_DIR=var/mail

# Bootstrap admin (used by: python -m app.cli create-admin)
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!123
